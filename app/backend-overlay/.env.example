APP_NAME="POSTGRES MANAGER"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
LOG_CHANNEL=daily

# Master DB (role pgm_app, hanya akses postgres_master)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=postgres_master
DB_USERNAME=pgm_app
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Role provisioning (CREATEDB + CREATEROLE, BUKAN superuser)
PGM_ADMIN_USER=pgm_provisioner
PGM_ADMIN_PASSWORD=
PGM_ROOT=/home/pi/Database/postgres-manager
PGM_ADMIN_EMAIL=nnaufalasyam7@gmail.com
# Password admin awal: isi sementara lalu hapus, atau kosongkan untuk prompt interaktif
PGM_INITIAL_PASSWORD=
